@page "/singlePrediction"
@using System.Text.RegularExpressions
@using Forester.Application.Exceptions
@using Forester.Application.Interfaces
@using Forester.Application.Services
@using Forester.Domain.Entities
@using Microsoft.AspNetCore.Components;

@inject ILogService Logservice

@rendermode InteractiveServer
@* https://stackoverflow.com/questions/65349476/blazor-cant-find-referenced-component-from-other-folder *@

@inject ILogService LogService

<h2>Single Prediction</h2>

<h6>Please enter values for single prediction of cover</h6>

<div class="input-container">
    <div class="input-row">
        <label>Elevation</label>
        @*https://stackoverflow.com/questions/69888168/how-to-set-input-box-value-to-a-string-in-blazor-webassembly *@
        <input type="number" @bind="userInputs.Elevation" />
    </div>
    <div class="input-row">
        <label>Aspect</label>
        <input type="number" @bind="userInputs.Aspect" />
    </div>
    <div class="input-row">
        <label>Slope</label>
        <input type="number" @bind="userInputs.Slope" />
    </div>
    <div class="input-row">
        <label>Vertical distance to hydrology</label>
        <input type="number" @bind="userInputs.Vertical_Distance_To_Hydrology" />
    </div>
    <div class="input-row">
        <label>Horizontal distance to hydrology</label>
        <input type="number" @bind="userInputs.Horizontal_Distance_To_Hydrology" />
    </div>
    <div class="input-row">
        <label>Horizontal distance to roadways</label>
        <input type="number" @bind="userInputs.Horizontal_Distance_To_Roadways" />
    </div>
    <div class="input-row">
        <label>Hillshade at 9 am</label>
        <input type="number" @bind="userInputs.Hillshade_9am" />
    </div>
    <div class="input-row">
        <label>Hillshade at 12 am </label>
        <input type="number" @bind="userInputs.Hillshade_Noon" />
    </div>
    <div class="input-row">
        <label>Hillshade at 3 pm</label>
        <input type="number" @bind="userInputs.Hillshade_3pm" />
    </div>
    <div class="input-row">
        <label>Horizontal distance to fire points </label>
        <input type="number" @bind="userInputs.Horizontal_Distance_To_Fire_Points" />
    </div>
    <div class="input-row">
        <label>Wilderness area (1-4) </label>
        <input type="number" @bind="userInputs.Wilderness_Area" />
    </div>
    <div class="input-row">
        <label>Soil type (1-40) </label>
        <input type="number" @bind="userInputs.Soil_Type" />
    </div>
    <button class="submit" type="button" @onclick="HandlePrediction">Submit input data</button>
    <div class="error-container">
        <p class="error-text">@errorMessage</p>
    </div>

    <div class="model-answer-area">
        <label>Model answer: </label>
        <p class="model-answer">@modelPredictionResult</p>
    </div>

</div>

<style>
    h2,
    h6 {
        text-align: center;
        margin-top: 1%;
    }

    .submit {
        margin-top: 2%;
        background-color: darkorange;
        width: 50%;
    }

    .error-text {
        color: red;
    }

    .input-container {
        width: 60%;
        margin-left: auto;
        margin-right: auto;
        text-align: center;
    }

    .input-row {
        width: 70%;
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-top: 2%;
        margin-left: auto;
        margin-right: auto;
    }

    .model-answer-area {
        border: 1px solid orange;
        width: 70%;
        margin-left: auto;
        margin-right: auto;
    }
</style>

@code {
    private UserInput userInputs = new();
    private string errorMessage = "";
    private int modelPredictionResult = 0;
    private async Task HandlePrediction()
    {
        try
        {
            modelPredictionResult = 0;
            errorMessage = "";
            ValidateInputValues(userInputs);

            await sendSinglePredictionRequest(userInputs);

            StateHasChanged();
            
            await LogService.LogUserPredictionRequest(userInputs, modelPredictionResult, "asdf");
        }
        catch (InvalidInputException e)
        {
            errorMessage = $"Input values are invalid, please try again: {e.Message}";
        }
        catch (Exception e)
        {
            Console.WriteLine($"Connection to API failed: {e.Message}");
            errorMessage = "Model cannot be contacted, blame the developers and please try again later";
        }
        //https://learn.microsoft.com/en-us/dotnet/fundamentals/networking/http/httpclient
        //contact FASTAPI for model prediciton

    }

    private async Task sendSinglePredictionRequest(UserInput userInputs)
    {
        string modelContactContainerURL = "http://fastapi-container:8000/";
        string modelContactURLLocal = "http://localhost:8000/";

        await contactFastAPIService(modelContactURLLocal, userInputs);
        //https://stackoverflow.com/questions/4734116/find-and-extract-a-number-from-a-string
    }

    private async Task contactFastAPIService(string modelContactContainerURL, UserInput userInputs)
    {
        HttpClient client = new HttpClient();
        client.BaseAddress = new Uri(modelContactContainerURL);

        HttpResponseMessage response = await client.PostAsJsonAsync("predict/single", userInputs, new
System.Text.Json.JsonSerializerOptions
        {
            PropertyNamingPolicy = null
        });
        modelPredictionResult = await ParsePredictionResponse(response);
    }

    private async Task<int> ParsePredictionResponse(HttpResponseMessage response)
    {
        var result = Regex.Match(await response.Content.ReadAsStringAsync(), @"\d+").Value;
        return int.Parse(result);
    }

    private void ValidateInputValues(UserInput input)
    {
        if (!HillshadeBetween0And255(input.Hillshade_3pm) || !HillshadeBetween0And255(input.Hillshade_9am) ||
            !HillshadeBetween0And255(input.Hillshade_Noon))
        {
            throw new InvalidInputException("Hillshade values must be between 0 and 255");
        }
        if (input.Slope < 0 || input.Slope > 360)
        {
            throw new InvalidInputException("Slope values must be between 0 and 360");
        }
        if (input.Wilderness_Area < 1 || input.Wilderness_Area > 4)
        {
            throw new InvalidInputException("Wilderness area value must be between 1 and 4");
        }
        if (input.Soil_Type < 1 || input.Soil_Type > 40)
        {
            throw new InvalidInputException("Soil type value must be between 1 and 40");
        }
    }

    private bool HillshadeBetween0And255(int hillshade)
    {
        return (hillshade >= 0 && hillshade <= 255);
    }

}

